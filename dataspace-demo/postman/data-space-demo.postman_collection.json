{
  "info": {
    "_postman_id": "04a5ddc6-0dda-4c7c-bf54-3d43bd95b712",
    "name": "Data space FIWARE - demo didatica (FDC simplificado)",
    "description": "Setup e operacao minima de um data space didatico com 2 produtores FIWARE (Orion + conector) e 1 consumidor. Reproduz os 5 passos: publicar oferta, descobrir, negociar, transferir e aplicar a politica de uso (soberania). Execute as pastas em ordem, de cima para baixo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
