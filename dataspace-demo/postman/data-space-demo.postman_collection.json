    {
      "name": "5 - Aplicacao da politica (soberania)",
      "item": [
        {
          "name": "Visualizar dado de A (permitido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseC}}/use",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"AirQualityObserved\",\n  \"action\": \"visualizar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('uso permitido (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tentar redistribuir dado de A (deve falhar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseC}}/use",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"AirQualityObserved\",\n  \"action\": \"redistribuir\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bloqueado pela politica (403)', () => pm.response.to.have.status(403));",
                  "pm.test('motivo menciona redistribuicao', () => pm.expect(pm.response.text()).to.include('redistrib'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar dados recebidos pelo consumidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseC}}/received"
          },
          "response": []
        }
      ]
