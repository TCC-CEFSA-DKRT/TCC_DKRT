                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orionA}}/v2/entities",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"urn:ngsi-ld:NoiseLevelObserved:demo-001\",\n  \"type\": \"NoiseLevelObserved\",\n  \"value\": { \"value\": 67.5, \"type\": \"Number\" },\n  \"domain\": { \"value\": \"Ruido urbano\", \"type\": \"Text\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entidade criada (201) ou ja existia (422)', () => [201,422].includes(pm.response.code));"
