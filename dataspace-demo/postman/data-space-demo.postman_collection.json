      ]
    },
    {
      "name": "2 - Negociacao de contrato",
      "item": [
        {
          "name": "Negociar com Produtor A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseA}}/negotiate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"AirQualityObserved\",\n  \"consumerId\": \"{{consumerId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('agreementA', json.agreementId);",
                  "pm.collectionVariables.set('policyA', JSON.stringify(json.policy));",
                  "pm.test('negociacao com Produtor A OK (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Negociar com Produtor B",
          "request": {
            "method": "POST",
            "header": [
              {
