# FIWARE Orion Context Broker (NGSI-v2)
FIWARE_BROKER_URL=http://localhost:1026
FIWARE_SERVICE=openiot
FIWARE_SERVICE_PATH=/
FIWARE_API_KEY=

# SLM — Ollama (Qwen2.5) recomendado; heurística se SLM_ENABLED=false
SLM_ENABLED=true
SLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT_SECONDS=120

# Alternativa: Hugging Face local (pip install -e ".[slm]")
# SLM_PROVIDER=transformers
# SLM_MODEL=microsoft/phi-2

# MCP
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Orquestrador
AGENT_TIMEOUT_SECONDS=30
