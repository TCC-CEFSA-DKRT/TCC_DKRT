# FIWARE Orion Context Broker (NGSI-v2) — usada apenas em DEPLOYMENT_MODE=selfhosted.
# Em DEPLOYMENT_MODE=saas, esta URL e' ignorada: cada tenant tem seu proprio
# broker_url/broker_api_key em tenant_accounts (ver DEPLOYMENT_MODE abaixo e ADR-0019).
FIWARE_BROKER_URL=http://localhost:1026
FIWARE_SERVICE=openiot
FIWARE_SERVICE_PATH=/

# Banco de dados — auditorias, cache de schema (Fase 2/3), RAG via pgvector (Fase 6)
DATABASE_URL=postgresql+asyncpg://auditor:auditor@localhost:5433/auditor

# SLM — Ollama (Nivel 2, analise semantica — a partir da Fase 7)
SLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=120

# Fase 8 — origens permitidas para CORS (separadas por vírgula). Cobre
# `ng serve` local tanto por `localhost:4200` quanto por `127.0.0.1:4200`
# — o navegador manda um Origin diferente dependendo de qual dos dois foi
# digitado na barra de endereço, e o CORS compara a string exata.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Intervalo (s) entre sincronizações automáticas do catálogo de Smart Data
# Models — CatalogSyncScheduler roda em background no processo da API,
# sincronizando no startup e depois a cada N segundos, para a tela Catalog
# do frontend não depender de rodar `audit catalog sync` manualmente.
# Default: 24h (86400s).
CATALOG_SYNC_INTERVAL_SECONDS=86400

# ADR-0019 — chaves Fernet (lista separada por vírgula) usadas para cifrar
# tenant_accounts.broker_api_key_encrypted em repouso. A primeira da lista
# cifra; todas decifram. Rotação: coloque a nova na frente, re-cifre as
# linhas (`audit tenant rotate-keys`), depois remova a antiga. Gerar cada chave com Fernet.generate_key().
BROKER_API_KEY_ENCRYPTION_KEYS=

# ADR-0019 — modo de implantação: "selfhosted" (default, um produtor, um
# broker, tenant fixo via Settings, sem login) ou "saas" (multi-tenant,
# tenant derivado de um JWT emitido por POST /auth/login).
DEPLOYMENT_MODE=selfhosted

# Obrigatória com pelo menos 32 bytes quando DEPLOYMENT_MODE=saas — assina e
# valida os JWTs emitidos em /auth/login. Gerar com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Validade (minutos) do token emitido em /auth/login.
JWT_EXPIRATION_MINUTES=60
