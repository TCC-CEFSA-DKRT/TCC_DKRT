#!/bin/bash
# Fase 9 -- bootstrap da instância Ollama (SLM local, decisão do usuário:
# ver docs/decisions/0001-ollama-ec2-vs-bedrock.md). O instalador oficial
# já cria e habilita o serviço systemd `ollama.service`; aqui só ajustamos
# OLLAMA_HOST para aceitar conexões de dentro da VPC (não apenas
# localhost, o default) e pré-baixamos o modelo para a API/worker não
# esperarem o primeiro pull na primeira chamada.
set -euo pipefail

curl -fsSL https://ollama.com/install.sh | sh

mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/override.conf <<'UNIT'
[Service]
Environment="OLLAMA_HOST=0.0.0.0:11434"
UNIT

systemctl daemon-reload
systemctl enable ollama
systemctl restart ollama

# Espera o serviço subir antes de puxar o modelo.
for i in $(seq 1 30); do
  curl -sf http://127.0.0.1:11434/ && break
  sleep 2
done

ollama pull ${ollama_model}
