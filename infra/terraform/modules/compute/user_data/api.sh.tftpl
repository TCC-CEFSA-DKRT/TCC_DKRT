#!/bin/bash
# Bootstrap da instância da API no ambiente dev (EC2), ADR-0021. A API roda
# como contêiner (imagem selfhosted/Dockerfile publicada no ECR do ambiente):
# esta instância é só o host Docker. O user_data prepara o host e instala o
# comando `auditor-deploy`; quem troca a versão da aplicação é o pipeline de
# deploy (GitHub Actions -> SSM Run Command -> auditor-deploy), nunca o
# terraform apply.
#
# Atenção: este arquivo é um template do Terraform. Em shell use $VAR sem
# chaves; um `$${VAR}` literal precisa ser escapado com dois cifrões.
set -euo pipefail
exec > >(tee -a /var/log/auditor-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io jq curl unzip python3

systemctl enable --now docker

if ! command -v aws > /dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

# A AMI Ubuntu 22.04 da Canonical já traz o SSM Agent (snap); garante que esteja ativo.
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true

mkdir -p /opt/auditor/secrets
chmod 700 /opt/auditor/secrets

# Configuração estática (sem segredos). A senha do banco é lida do Secrets
# Manager a cada deploy e escrita só em runtime.env (0600). Os valores não
# têm espaços nem aspas, porque o mesmo arquivo é lido por `docker --env-file`
# e por `source`.
# AWS_DEFAULT_REGION: o boto3 nao le AWS_REGION; sem ela a API cai ao iniciar
# (NoRegionError ao criar o cliente do SQS).
cat > /opt/auditor/static.env <<ENV
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
DEPLOYMENT_MODE=${deployment_mode}
DB_HOST=${database_host}
DB_PORT=${database_port}
DB_NAME=${database_name}
DB_MASTER_USER_SECRET_ARN=${database_secret_arn}
FIWARE_BROKER_URL=${fiware_broker_url}
OLLAMA_BASE_URL=${ollama_base_url}
OLLAMA_MODEL=${ollama_model}
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=${queue_url}
CORS_ALLOWED_ORIGINS=${cors_allowed_origins}
ENV
chmod 600 /opt/auditor/static.env

cat > /usr/local/bin/auditor-deploy <<'SCRIPT'
#!/bin/bash
# Uso: auditor-deploy migrate <imagem>   aplica as migrações Alembic com a imagem nova
#      auditor-deploy start <imagem>     troca o contêiner da API pela imagem nova
# <imagem> é a referência completa no ECR, ex.:
#   123456789012.dkr.ecr.us-east-1.amazonaws.com/auditor-dev-auditor:dev-abc1234
set -euo pipefail

ACTION="$1"
IMAGE="$2"

set -a
. /opt/auditor/static.env
set +a

REGISTRY="$(echo "$IMAGE" | cut -d/ -f1)"
aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$IMAGE"

# DATABASE_URL só existe em runtime.env: usuário e senha do segredo gerenciado
# pelo RDS (a senha pode ter caracteres especiais, por isso o urlencode).
SECRET="$(aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$DB_MASTER_USER_SECRET_ARN" --query SecretString --output text)"
DB_USER="$(echo "$SECRET" | jq -r .username)"
DB_PASS="$(echo "$SECRET" | jq -r .password | python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.stdin.read().rstrip("\n"), safe=""))')"
# asyncpg nao entende `sslmode` (parametro do psycopg2): o equivalente e `ssl=require`.
umask 077
{
  cat /opt/auditor/static.env
  echo "DATABASE_URL=postgresql+asyncpg://$DB_USER:$DB_PASS@$DB_HOST:$DB_PORT/$DB_NAME?ssl=require"
} > /opt/auditor/runtime.env

case "$ACTION" in
  migrate)
    # A pasta de segredos precisa existir: o entrypoint (fernet-keys.sh) grava as chaves nela.
    docker run --rm --env-file /opt/auditor/runtime.env \
      -v /opt/auditor/secrets:/var/lib/auditor-secrets \
      "$IMAGE" alembic upgrade head
    ;;
  start)
    docker rm -f auditor-api > /dev/null 2>&1 || true
    docker run -d --name auditor-api --restart unless-stopped \
      --env-file /opt/auditor/runtime.env \
      -p 8000:8000 \
      -v /opt/auditor/secrets:/var/lib/auditor-secrets \
      "$IMAGE"
    echo "$IMAGE" > /opt/auditor/current-image
    for _ in $(seq 1 30); do
      if curl -fsS http://localhost:8000/health/ready > /dev/null; then
        echo "API pronta: $IMAGE"
        exit 0
      fi
      sleep 4
    done
    docker logs --tail 80 auditor-api
    echo "A API não respondeu em /health/ready" >&2
    exit 1
    ;;
  *)
    echo "ação desconhecida: $ACTION" >&2
    exit 2
    ;;
esac
SCRIPT
chmod 755 /usr/local/bin/auditor-deploy
